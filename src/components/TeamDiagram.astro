---
import type { Site } from '../lib/content';
interface Props { data: Site['team']; labels: Site['ui']['modelLabel'] }
const { data, labels } = Astro.props;
const first = data.agents[0];
---
<section id="team"><div class="container">
  <p class="eyebrow">{data.eyebrow}</p><h2>{data.title}</h2>
  <p class="lead">{data.intro}</p>

  <div class="org">
    <div class="tier card human"><strong>{data.human.role}</strong><p>{data.human.does}</p></div>
    <div class="link" aria-hidden="true"></div>
    <div class="tier card coord"><strong>{data.coordinator.role}</strong><p>{data.coordinator.does}</p></div>
    <div class="link" aria-hidden="true"></div>
    <ul class="agents">
      {data.agents.map((a) => (
        <li class="card agent" data-agent={a.id} data-model={a.model} data-does={a.does} data-label={labels[a.model]} tabindex="0">
          <strong>{a.role}</strong>
          <p class="does">{a.does}</p>
          <span class={`chip ${a.model}`}>{labels[a.model]}</span>
        </li>))}
    </ul>
    <div class="card detail" data-testid="agent-detail" aria-live="polite">
      <strong data-role>{first.role}</strong><p data-does>{first.does}</p><span data-model class={`chip ${first.model}`}>{labels[first.model]}</span>
    </div>
  </div>

  <h3>{data.flowTitle}</h3>
  <ol class="flow">{data.flow.map((f, i) => <li><span class="n">{String(i + 1).padStart(2, '0')}</span><strong>{f.label}</strong><p>{f.detail}</p></li>)}</ol>

  <div class="statement">
    <h3>{data.principlesTitle}</h3>
    <ul class="principles">{data.principles.map((p) => <li>{p}</li>)}</ul>
  </div>
</div></section>

<script is:inline>
  (() => {
    const root = document.getElementById('team'); if (!root) return;
    const d = root.querySelector('[data-testid="agent-detail"]');
    const pick = (li) => {
      root.querySelectorAll('.agent').forEach((x) => x.classList.toggle('on', x === li));
      d.querySelector('[data-role]').textContent = li.querySelector('strong').textContent;
      d.querySelector('[data-does]').textContent = li.dataset.does;
      const m = d.querySelector('[data-model]'); m.textContent = li.dataset.label; m.className = 'chip ' + li.dataset.model;
    };
    root.querySelectorAll('.agent').forEach((li) => {
      li.addEventListener('click', () => pick(li));
      li.addEventListener('mouseenter', () => pick(li));
      li.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); pick(li); } });
    });
    root.classList.add('js');
  })();
</script>

<style>
  .lead { color: var(--soft); max-width: 44rem; font-size: clamp(1.1rem, 2vw, 1.3rem); letter-spacing: -0.012em; margin: 0; }
  .org { display: grid; grid-template-columns: minmax(0, 1fr); justify-items: center; margin: var(--space-7) 0; }
  .tier { width: min(560px, 100%); text-align: center; } .tier p { color: var(--soft); margin: .35rem 0 0; font-size: .95rem; }
  .tier strong { font-weight: 500; }
  .human { background: var(--panel); color: var(--panel-ink); border-color: var(--panel); } .human p { color: var(--panel-muted); }
  .coord { border-color: var(--border-strong); }
  .link { width: 1px; height: var(--space-6); background: var(--border-strong); }
  .agents { list-style: none; padding: 0; margin: 0; width: 100%; display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); }
  .agent { cursor: pointer; transition: border-color .16s, background .16s; display: flex; flex-direction: column; gap: .4rem; }
  .agent strong { font-weight: 500; }
  .agent:hover, .agent:focus-visible, .agent.on { border-color: var(--fg); outline: none; }
  .agent .does { color: var(--soft); font-size: .9rem; margin: 0; }
  .chip { display: inline-flex; align-self: flex-start; align-items: center; gap: .4rem; padding: .25rem .5rem; border-radius: 2px; border: 1px solid var(--border-strong);
    font: 400 .6rem/1.3 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); white-space: normal; }
  .chip::before { content: ""; width: 6px; height: 6px; border-radius: 999px; border: 1px solid currentColor; }
  .chip.strong { color: var(--fg); border-color: var(--fg); } .chip.strong::before { background: currentColor; }
  .detail { display: none; width: min(560px, 100%); margin-top: var(--space-4); text-align: center; }
  .detail .chip { align-self: center; margin-top: .5rem; }
  :global(#team.js) .detail { display: flex; flex-direction: column; align-items: center; }
  @media (min-width: 900px) { :global(#team.js) .agent .does { display: none; } }
  h3 { margin: var(--space-7) 0 var(--space-5); font-size: 1.5rem; font-weight: 400; letter-spacing: -0.03em; }
  .flow { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-5); grid-template-columns: repeat(auto-fit, minmax(min(100%, 120px), 1fr)); }
  .flow li { border-top: 1px solid var(--fg); padding-top: var(--space-3); }
  .flow .n { font: 400 .68rem/1 var(--font-mono); letter-spacing: .14em; color: var(--muted); display: block; margin-bottom: .5rem; }
  .flow strong { font-weight: 500; }
  .flow p { color: var(--soft); font-size: .88rem; margin: .3rem 0 0; }
  .statement { background: var(--panel); color: var(--panel-ink); padding: clamp(2rem, 6vw, 4rem); margin-top: var(--space-8); border-radius: var(--radius); }
  .statement h3 { margin-top: 0; font-family: var(--font-mono); font-size: .7rem; letter-spacing: .14em; text-transform: uppercase; color: var(--panel-muted); }
  .statement h3::before { content: "Λ "; color: var(--panel-ink); }
  .principles { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-3); counter-reset: r; }
  .principles li { font-size: clamp(1.2rem, 2.6vw, 1.75rem); font-weight: 350; letter-spacing: -0.02em; line-height: 1.3; }
</style>
