---
interface Props { lang: 'en' | 'pl'; name: string; nav: { href: string; label: string }[]; switchLabel: string; themeLabel: string }
const { lang, name, nav, switchLabel, themeLabel } = Astro.props;
const other = lang === 'en' ? '/pl/' : '/';
---
<header class="hdr">
  <div class="container row">
    <a class="name" href={lang === 'en' ? '/' : '/pl/'}>{name}</a>
    <nav aria-label="Sections"><ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul></nav>
    <div class="actions">
      <a data-testid="lang-switch" href={other} hreflang={lang === 'en' ? 'pl' : 'en'}>{switchLabel}</a>
      <button data-testid="theme-toggle" type="button" aria-label={themeLabel}>◐</button>
    </div>
  </div>
</header>
<script is:inline>
  document.querySelector('[data-testid="theme-toggle"]')?.addEventListener('click', () => {
    const root = document.documentElement;
    const cur = root.dataset.theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = cur === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });
</script>
<style>
  .hdr { position: sticky; top: 0; z-index: 10; background: color-mix(in srgb, var(--bg) 90%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--border); }
  .row { display: flex; align-items: center; gap: var(--space-5); min-height: 4rem; }
  .name { font: 500 .8rem/1 var(--font-mono); letter-spacing: .22em; text-transform: uppercase; color: var(--fg); text-decoration: none; margin-right: auto; }
  nav ul { display: flex; gap: var(--space-5); list-style: none; margin: 0; padding: 0; }
  nav a, .actions a { color: var(--soft); text-decoration: none; font-size: .9rem; }
  nav a:hover, .actions a:hover { color: var(--fg); }
  .actions { display: flex; gap: var(--space-3); align-items: center; }
  .actions a { font: 400 .72rem/1 var(--font-mono); letter-spacing: .12em; border: 1px solid var(--border-strong); padding: .55rem .6rem; border-radius: 2px; }
  button { background: none; border: 1px solid var(--border-strong); color: var(--fg); border-radius: 2px; width: 2.1rem; height: 2.1rem; cursor: pointer; }
  @media (max-width: 720px) { nav { display: none; } }
</style>
