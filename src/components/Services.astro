---
import type { Site } from '../lib/content';
interface Props { data: Site['services'] }
const { data } = Astro.props;
---
<section id="what"><div class="container">
  <p class="eyebrow">{data.eyebrow}</p><h2>{data.title}</h2>
  <div class="grid">
    {data.items.map((it) => (
      <article class="card"><h3>{it.title}</h3><p>{it.body}</p>
        <ul>{it.points.map((p) => <li>{p}</li>)}</ul></article>))}
  </div>
</div></section>
<style>
  .card { display: flex; flex-direction: column; gap: var(--space-3); }
  h3 { margin: 0; }
  p { color: var(--soft); margin: 0; font-size: .95rem; }
  ul { list-style: none; padding: var(--space-3) 0 0; margin: auto 0 0; border-top: 1px solid var(--border); }
  li { font: 400 .7rem/1.9 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
</style>
